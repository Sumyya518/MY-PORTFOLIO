    <!-- Hero Section -->
    <section class="section pt-32 pb-16">
        <div class="container-custom">
            <div class="text-center mb-12">
                <div class="inline-flex items-center gap-2 px-4 py-2 bg-primary/10 border border-primary rounded-full text-primary text-sm font-semibold mb-6">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M10.394 2.08a1 1 0 00-.788 0l-7 3a1 1 0 000 1.84L5.25 8.051a.999.999 0 01.356-.257l4-1.714a1 1 0 11.788 1.838L7.667 9.088l1.94.831a1 1 0 00.787 0l7-3a1 1 0 000-1.838l-7-3zM3.31 9.397L5 10.12v4.102a8.969 8.969 0 00-1.05-.174 1 1 0 01-.89-.89 11.115 11.115 0 01.25-3.762zM9.3 16.573A9.026 9.026 0 007 14.935v-3.957l1.818.78a3 3 0 002.364 0l5.508-2.361a11.026 11.026 0 01.25 3.762 1 1 0 01-.89.89 8.968 8.968 0 00-5.35 2.524 1 1 0 01-1.4 0zM6 18a1 1 0 001-1v-2.065a8.935 8.935 0 00-2-.712V17a1 1 0 001 1z"/>
                    </svg>
                    Educational Platform Case Studies
                </div>
                <h1 class="text-hero font-headline text-gradient-primary mb-6">
                    Transforming Education Through Technology
                </h1>
                <p class="text-body-lg text-text-secondary max-w-4xl mx-auto mb-8">
                    Three diverse educational platform implementations showcasing expertise in learning management systems, from international institutes to industrial training portals. Each project delivered measurable improvements in student engagement, administrative efficiency, and educational outcomes.
                </p>
                
                <!-- Quick Stats -->
                <div class="grid md:grid-cols-4 gap-6 max-w-5xl mx-auto">
                    <div class="bg-surface border border-border rounded-xl p-6">
                        <div class="text-accent font-bold text-3xl mb-2">3</div>
                        <div class="text-text-secondary text-sm">Educational Platforms</div>
                    </div>
                    <div class="bg-surface border border-border rounded-xl p-6">
                        <div class="text-primary font-bold text-3xl mb-2">5,000+</div>
                        <div class="text-text-secondary text-sm">Active Students</div>
                    </div>
                    <div class="bg-surface border border-border rounded-xl p-6">
                        <div class="text-secondary font-bold text-3xl mb-2">95%</div>
                        <div class="text-text-secondary text-sm">Avg Engagement Rate</div>
                    </div>
                    <div class="bg-surface border border-border rounded-xl p-6">
                        <div class="text-accent font-bold text-3xl mb-2">60%</div>
                        <div class="text-text-secondary text-sm">Time Savings</div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Project Selector -->
    <section class="section bg-background-light">
        <div class="container-custom">
            <div class="text-center mb-12">
                <h2 class="text-h2 font-headline mb-4">Select Platform to Explore</h2>
                <p class="text-text-secondary">Click on any platform to view detailed case study</p>
            </div>

            <div class="grid md:grid-cols-3 gap-6 mb-16">
                <!-- Aaysha International Institute -->
                <button onclick="showPlatform('aaysha')" id="aaysha-btn" class="platform-selector active">
                    <div class="relative">
                        <div class="aspect-video rounded-lg overflow-hidden mb-4">
                            <img src="https://img.rocket.new/generatedImages/rocket_gen_img_183e41728-1764835500358.png" alt="Aaysha International Institute" class="w-full h-full object-cover" onerror="this.src='https://images.unsplash.com/photo-1523240795612-9a054b0db644?q=80&w=2940&auto=format&fit=crop'; this.onerror=null;">
                        </div>
                        <div class="flex items-center gap-2 mb-2">
                            <span class="px-3 py-1 bg-primary/10 text-primary text-xs font-semibold rounded-full">International Institute</span>
                        </div>
                        <h3 class="text-h4 font-headline mb-2">Aaysha International Institute</h3>
                        <p class="text-text-secondary text-sm">Student enrollment system with 400% efficiency improvement</p>
                    </div>
                </button>

                <!-- Al Harmain Institute -->
                <button onclick="showPlatform('alharmain')" id="alharmain-btn" class="platform-selector">
                    <div class="relative">
                        <div class="aspect-video rounded-lg overflow-hidden mb-4">
                            <img src="https://img.rocket.new/generatedImages/rocket_gen_img_179aeddcc-1765370460387.png" alt="Al Harmain Institute" class="w-full h-full object-cover" onerror="this.src='https://images.unsplash.com/photo-1524178232363-1fb2b075b655?q=80&w=2940&auto=format&fit=crop'; this.onerror=null;">
                        </div>
                        <div class="flex items-center gap-2 mb-2">
                            <span class="px-3 py-1 bg-secondary/10 text-secondary text-xs font-semibold rounded-full">Islamic Education</span>
                        </div>
                        <h3 class="text-h4 font-headline mb-2">Al Harmain Institute</h3>
                        <p class="text-text-secondary text-sm">Islamic education platform with Arabic language support</p>
                    </div>
                </button>

                <!-- Metal Stickers India -->
                <button onclick="showPlatform('metalstickers')" id="metalstickers-btn" class="platform-selector">
                    <div class="relative">
                        <div class="aspect-video rounded-lg overflow-hidden mb-4">
                            <img src="https://img.rocket.new/generatedImages/rocket_gen_img_1f96a294e-1767028151049.png" alt="Metal Stickers India Training" class="w-full h-full object-cover bg-white" onerror="this.src='https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?q=80&w=2940&auto=format&fit=crop'; this.onerror=null;">
                        </div>
                        <div class="flex items-center gap-2 mb-2">
                            <span class="px-3 py-1 bg-accent/10 text-accent text-xs font-semibold rounded-full">Industrial Training</span>
                        </div>
                        <h3 class="text-h4 font-headline mb-2">Metal Stickers India</h3>
                        <p class="text-text-secondary text-sm">Industrial training management with safety certification</p>
                    </div>
                </button>
            </div>

            <!-- Aaysha International Institute Case Study -->
            <div id="aaysha-content" class="platform-content">
                <!-- Overview -->
                <div class="card mb-8">
                    <div class="grid lg:grid-cols-2 gap-8">
                        <div>
                            <h3 class="text-h3 font-headline mb-4">Aaysha International Institute</h3>
                            <p class="text-text-secondary mb-6">
                                Comprehensive learning management system for an international educational institute, featuring advanced student enrollment, course management, and parent-student communication capabilities. The platform streamlined administrative workflows and improved student engagement through modern digital tools.
                            </p>
                            <div class="space-y-4">
                                <div class="flex items-start gap-3">
                                    <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center flex-shrink-0">
                                        <svg class="w-5 h-5 text-primary" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                                        </svg>
                                    </div>
                                    <div>
                                        <div class="text-text-primary font-semibold">Real-time Enrollment System</div>
                                        <div class="text-text-secondary text-sm">Automated student registration with instant course assignment</div>
                                    </div>
                                </div>
                                <div class="flex items-start gap-3">
                                    <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center flex-shrink-0">
                                        <svg class="w-5 h-5 text-primary" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                                        </svg>
                                    </div>
                                    <div>
                                        <div class="text-text-primary font-semibold">Digital Certificate Generation</div>
                                        <div class="text-text-secondary text-sm">Automated certificate creation and distribution system</div>
                                    </div>
                                </div>
                                <div class="flex items-start gap-3">
                                    <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center flex-shrink-0">
                                        <svg class="w-5 h-5 text-primary" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                                        </svg>
                                    </div>
                                    <div>
                                        <div class="text-text-primary font-semibold">Parent-Student Portal</div>
                                        <div class="text-text-secondary text-sm">Secure communication hub with progress tracking</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="space-y-4">
                            <a href="https://aayshainternational.in/" target="_blank" rel="noopener" class="block rounded-lg overflow-hidden border border-border hover:border-primary transition-250">
                                <img src="https://img.rocket.new/generatedImages/rocket_gen_img_1f9e2fd33-1766941708363.png" alt="Aaysha International Platform Screenshot" class="w-full h-64 object-cover" onerror="this.src='https://images.unsplash.com/photo-1523240795612-9a054b0db644?q=80&w=2940&auto=format&fit=crop'; this.onerror=null;">
                            </a>
                            <a href="https://aayshainternational.in/" target="_blank" rel="noopener" class="btn-primary w-full text-center">
                                View Live Platform →
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Technology Stack -->
                <div class="card mb-8">
                    <h3 class="text-h3 font-headline mb-6">Technology Stack</h3>
                    <div class="grid md:grid-cols-3 gap-6">
                        <div>
                            <div class="text-text-secondary text-sm font-semibold mb-3">Frontend</div>
                            <div class="flex flex-wrap gap-2">
                                <span class="px-3 py-1 bg-primary/10 text-primary text-sm rounded-full">React 18.2</span>
                                <span class="px-3 py-1 bg-primary/10 text-primary text-sm rounded-full">TypeScript</span>
                                <span class="px-3 py-1 bg-primary/10 text-primary text-sm rounded-full">Tailwind CSS</span>
                            </div>
                        </div>
                        <div>
                            <div class="text-text-secondary text-sm font-semibold mb-3">Backend</div>
                            <div class="flex flex-wrap gap-2">
                                <span class="px-3 py-1 bg-secondary/10 text-secondary text-sm rounded-full">Node.js</span>
                                <span class="px-3 py-1 bg-secondary/10 text-secondary text-sm rounded-full">Express</span>
                                <span class="px-3 py-1 bg-secondary/10 text-secondary text-sm rounded-full">Firebase</span>
                            </div>
                        </div>
                        <div>
                            <div class="text-text-secondary text-sm font-semibold mb-3">Infrastructure</div>
                            <div class="flex flex-wrap gap-2">
                                <span class="px-3 py-1 bg-accent/10 text-accent text-sm rounded-full">Vercel</span>
                                <span class="px-3 py-1 bg-accent/10 text-accent text-sm rounded-full">Cloudinary</span>
                                <span class="px-3 py-1 bg-accent/10 text-accent text-sm rounded-full">Zoom API</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Before/After Metrics -->
                <div class="grid md:grid-cols-2 gap-8 mb-8">
                    <div class="card border-error/30">
                        <h4 class="text-h4 font-headline mb-4 text-error">Before Implementation</h4>
                        <ul class="space-y-3">
                            <li class="flex items-start gap-3">
                                <svg class="w-5 h-5 text-error mt-1" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                                </svg>
                                <span class="text-text-secondary">Manual paper-based enrollment taking 3-4 days per student</span>
                            </li>
                            <li class="flex items-start gap-3">
                                <svg class="w-5 h-5 text-error mt-1" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                                </svg>
                                <span class="text-text-secondary">Limited parent communication channels</span>
                            </li>
                            <li class="flex items-start gap-3">
                                <svg class="w-5 h-5 text-error mt-1" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                                </svg>
                                <span class="text-text-secondary">Manual certificate printing and distribution delays</span>
                            </li>
                            <li class="flex items-start gap-3">
                                <svg class="w-5 h-5 text-error mt-1" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                                </svg>
                                <span class="text-text-secondary">No centralized student progress tracking</span>
                            </li>
                        </ul>
                    </div>

                    <div class="card border-accent/30">
                        <h4 class="text-h4 font-headline mb-4 text-accent">After Implementation</h4>
                        <ul class="space-y-3">
                            <li class="flex items-start gap-3">
                                <svg class="w-5 h-5 text-accent mt-1" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                                </svg>
                                <span class="text-text-secondary"><strong class="text-accent">400% faster enrollment</strong> - completed in under 1 day</span>
                            </li>
                            <li class="flex items-start gap-3">
                                <svg class="w-5 h-5 text-accent mt-1" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                                </svg>
                                <span class="text-text-secondary"><strong class="text-accent">Real-time communication</strong> portal for parents</span>
                            </li>
                            <li class="flex items-start gap-3">
                                <svg class="w-5 h-5 text-accent mt-1" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                                </svg>
                                <span class="text-text-secondary"><strong class="text-accent">Instant certificate generation</strong> with digital verification</span>
                            </li>

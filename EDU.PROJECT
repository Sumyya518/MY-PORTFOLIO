                                <div class="text-text-primary font-semibold">Dr. Mohammed Aaysha</div>
                                <div class="text-text-tertiary text-sm">Director, Aaysha International Institute</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Al Harmain Institute Case Study -->
            <div id="alharmain-content" class="platform-content hidden">
                <!-- Overview -->
                <div class="card mb-8">
                    <div class="grid lg:grid-cols-2 gap-8">
                        <div>
                            <h3 class="text-h3 font-headline mb-4">Al Harmain Islamic Institute</h3>
                            <p class="text-text-secondary mb-6">
                                Specialized Islamic education platform featuring Arabic language support, prayer time integration, and culturally-sensitive UI design. The platform serves both traditional Islamic studies and modern educational needs with respect for cultural requirements and religious practices.
                            </p>
                            <div class="space-y-4">
                                <div class="flex items-start gap-3">
                                    <div class="w-10 h-10 rounded-lg bg-secondary/10 flex items-center justify-center flex-shrink-0">
                                        <svg class="w-5 h-5 text-secondary" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                                        </svg>
                                    </div>
                                    <div>
                                        <div class="text-text-primary font-semibold">Bilingual Interface</div>
                                        <div class="text-text-secondary text-sm">Full Arabic and English language support with RTL layouts</div>
                                    </div>
                                </div>
                                <div class="flex items-start gap-3">
                                    <div class="w-10 h-10 rounded-lg bg-secondary/10 flex items-center justify-center flex-shrink-0">
                                        <svg class="w-5 h-5 text-secondary" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>

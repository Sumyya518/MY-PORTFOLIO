                                <stop offset="0%" stop-color="#00F5FF"/>
                                <stop offset="100%" stop-color="#7C3AED"/>
                            </linearGradient>
                        </defs>
                    </svg>
                    <span class="font-headline text-xl font-bold text-gradient-primary">DevPortfolio Pro</span>
                </a>

                <!-- Desktop Navigation -->

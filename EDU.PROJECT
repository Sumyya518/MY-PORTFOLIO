                    <div class="flex items-start gap-4">
                        <div class="w-16 h-16 rounded-full bg-primary/20 flex items-center justify-center flex-shrink-0">
                            <svg class="w-8 h-8 text-primary" fill="currentColor" viewBox="0 0 20 20">
